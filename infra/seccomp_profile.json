        "getuid", "ioctl", "listen", "lseek", "madvise", "memfd_create", "mmap",
        "mprotect", "munmap", "nanosleep", "newfstatat", "openat", "pipe2", "poll",
        "prlimit64", "read", "readlink", "recvfrom", "recvmsg", "rt_sigaction",
